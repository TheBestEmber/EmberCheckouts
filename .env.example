# Generate a fresh value with: openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Rotation: give the new key a new ENCRYPTION_KEY_ID and list the old one in
# ENCRYPTION_KEYS (id:base64,...) for ten minutes, then remove it.
ENCRYPTION_KEY_ID=primary
ENCRYPTION_KEYS=
# Comma-separated CIDRs of the reverse proxy; empty trusts no X-Forwarded-For.
TRUSTED_PROXIES=
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgres://ember@127.0.0.1:55432/ember_checkouts?sslmode=disable
PUBLIC_BASE_URL=http://localhost:8080
EMBER_AUTH_URL=http://127.0.0.1:8081
EMBER_AUTH_JWKS_URL=http://host.docker.internal:8081/.well-known/jwks.json
